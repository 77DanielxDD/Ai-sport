# Copy to .env for local development
MYSQL_ROOT_PASSWORD=change_me

# LLM (GLM-4-flash, BigModel 智谱 AI, OpenAI 兼容接口)
APP_LLM_API_KEY=
APP_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
APP_LLM_MODEL=glm-4-flash
# ai-service 侧同样支持 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL（兼容旧名）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# 神经网络 rerank（SiliconFlow 托管 BAAI/bge-reranker-v2-m3 API）
APP_RERANK_API_KEY=
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Optional COS settings
DEV_OBJECT_STORAGE_ENABLED=false
DEV_OBJECT_STORAGE_PROVIDER=cos
DEV_OBJECT_STORAGE_REGION=ap-guangzhou
DEV_OBJECT_STORAGE_BUCKET=
DEV_OBJECT_STORAGE_ACCESS_KEY=
DEV_OBJECT_STORAGE_SECRET_KEY=
DEV_OBJECT_STORAGE_PUBLIC_BASE_URL=
